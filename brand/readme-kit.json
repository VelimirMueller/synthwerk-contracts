  "panels": [
    {
      "key": "lead",
      "type": "lead",
      "title": "ABOUT",
      "text": "**synthwerk-contracts** is the one contract of Synthwerk: OpenAPI 3.1 for HTTP, CloudEvents 1.0.2 with JSON Schema for events. CI generates the Go and TypeScript clients and fails every pull request that breaks a consumer. It runs nothing. It only makes promises."
    },
    {
      "key": "stats",
      "type": "stats",
      "title": "THE NUMBERS",
      "items": [
        { "value": "2", "label": "HEALTH ENDPOINTS" },
        { "value": "2", "label": "EVENT TYPES" },
        { "value": "6", "label": "CUSTOM LINT RULES" },
        { "value": "2", "label": "GENERATED CLIENTS" }
      ]
    },
    {
      "key": "features",
      "type": "cards",
      "title": "WRITE IT ONCE",
      "items": [
        {
          "title": "ONE SOURCE",
          "text": "Every API and every event is defined here first. Services follow the contract."
        },
        {
          "title": "GENERATED CLIENTS",
          "text": "Go (oapi-codegen) and TypeScript (openapi-fetch). CI fails when they drift."
        },
        {
          "title": "BREAKING = RED",
          "text": "oasdiff and eventcompat fail a PR that renames or removes a field."
        }
      ]
    },
    {
      "key": "what",
      "type": "notes",
      "title": "WHAT IT DOES",
      "columns": 2,
      "items": [
        {
          "lead": "Health API",
          "text": "`GET /healthz` and `GET /readyz` for every service. Pulse reads both."
        },
        {
          "lead": "Event envelope",
          "text": "CloudEvents 1.0.2 plus `orgid`, `traceparent` and `actor`. `tenantid` is deprecated (D-44)."
        },
        {
          "lead": "Event catalog",
          "text": "Per type: NATS subject, stream, producer, consumers, status, schema, example."
        },
        {
          "lead": "Naming rule",
          "text": "`dev.synthwerk.<domain>.<entity>.<verb>.v<N>`, verb in the past tense."
        }
      ]
    },
    {
      "key": "start",
      "type": "terminal",
      "title": "QUICK START",
      "lines": [
        "$ pnpm install",
        "$ just",
        "$ just breaking origin/main",
        "# lint, gen, test: all green"
      ]
    },
    {
      "key": "setup",
      "type": "commands",
      "title": "WHAT EACH STEP DOES",
      "rows": [
        {
          "cmd": "pnpm install",
          "text": "Spectral, Biome, openapi-typescript and TypeScript from `pnpm-lock.yaml`."
        },
        {
          "cmd": "just",
          "text": "Lint, generate the Go and TS clients, run every test and both selftests."
        },
        {
          "cmd": "just breaking origin/main",
          "text": "Check your branch against `main` for breaking changes."
        }
      ]
    },
    {
      "key": "startnotes",
      "type": "notes",
      "columns": 2,
      "items": [
        { "lead": "Needs", "text": "Go 1.27, Node 24, pnpm 12, `just`, golangci-lint v2." },
        {
          "lead": "Go tools",
          "text": "oapi-codegen and oasdiff come from `go.mod` as `go tool`. Nothing to install."
        }
      ]
    },
    {
      "key": "flow",
      "type": "flow",
      "title": "ONE CHANGE, LEFT TO RIGHT",
      "nodes": [
        { "title": "SPEC", "sub": "OpenAPI, JSON Schema" },
        { "title": "LINT", "sub": "Spectral, examples" },
        { "title": "GATE", "sub": "oasdiff, eventcompat", "hot": true },
        { "title": "CLIENTS", "sub": "Go, TypeScript" }
      ],
      "caption": "A pull request passes all four, or it does not merge."
    },
    {
      "key": "how",
      "type": "notes",
      "title": "THE GATES",
      "items": [
        {
          "lead": "Lint",
          "text": "Spectral checks names, security and size limits. A selftest proves that each rule fires."
        },
        {
          "lead": "Breaking",
          "text": "oasdiff on the APIs, eventcompat on the events, both against the PR base."
        },
        {
          "lead": "Selftest",
          "text": "A fixture PR renames a required field. CI expects the gate to fail on it."
        },
        {
          "lead": "Drift",
          "text": "CI generates the clients again and fails when the committed code differs."
        }
      ]
    },
    {
      "key": "api",
      "type": "commands",
      "title": "THE CONTRACTS",
      "rows": [
        { "cmd": "GET /healthz", "text": "The process runs. 200 with status ok." },
        {
          "cmd": "GET /readyz",
          "text": "One result per dependency. ok or degraded: 200. down: 503."
        },
        {
          "cmd": "pulse.target.status_changed.v1",
          "text": "Pulse saw a new readiness status of a target."
        },
        {
          "cmd": "llm.toolcall.executed.v1",
          "text": "Audit fact: the AI called one read-only MCP tool. Deprecated (D-44): use v2."
        },
        {
          "cmd": "llm.toolcall.executed.v2",
          "text": "Same fact. Scope: org, user, operator."
        }
      ]
    },
    {
      "key": "naming",
      "type": "commands",
      "title": "NAMING",
      "rows": [
        {
          "cmd": "dev.synthwerk.<domain>.<entity>.<verb>.v<N>",
          "text": "CloudEvents type. Verb in the past tense."
        },
        {
          "cmd": "evt.<domain>.<entity>.<verb>.v<N>",
          "text": "NATS subject. Stream `EVT_<DOMAIN>`."
        },
        {
          "cmd": "/v<N>/<plural-noun>",
          "text": "API path, kebab-case. operationId `<service>.<verb><Noun>`."
        },
        { "cmd": ".v<N+1> or /v<N+1>/", "text": "The only way to make a breaking change." }
      ]
    },
    {
      "key": "reference",
      "type": "notes",
      "columns": 2,
      "items": [
        { "lead": "Rules", "text": "Every name and its example: `docs/naming.md`." },
        {
          "lead": "Guide",
          "text": "Layout, commands, CI and how to add an API: `docs/developer-guide.md`."
        }
      ]
    },
    {
